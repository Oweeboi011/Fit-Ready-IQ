rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Helper: check if the request is from an authenticated user
    function isAuthenticated() {
      return request.auth != null;
    }

    // Helper: check if the requesting user owns the document
    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // Helper: the caller owns the document as it exists now.
    function ownsExisting() {
      return isAuthenticated() && request.auth.uid == resource.data.user_id;
    }

    // Helpers for validating an incoming document's optional fields.
    function optionalNumber(d, key) {
      return !(key in d) || d[key] == null || d[key] is number;
    }

    function optionalString(d, key, maxLen) {
      return !(key in d) || (d[key] is string && d[key].size() <= maxLen);
    }

    // One photo reference: a string of bounded length, when the list reaches
    // index i. Rules have no loops, so the ten allowed indices are spelled out.
    function photoOk(p, i) {
      return p.size() <= i || (p[i] is string && p[i].size() <= 2048);
    }

    function photosOk(d) {
      return !('photos' in d) || (
        d.photos is list && d.photos.size() <= 10
        && photoOk(d.photos, 0) && photoOk(d.photos, 1) && photoOk(d.photos, 2)
        && photoOk(d.photos, 3) && photoOk(d.photos, 4) && photoOk(d.photos, 5)
        && photoOk(d.photos, 6) && photoOk(d.photos, 7) && photoOk(d.photos, 8)
        && photoOk(d.photos, 9)
      );
    }

    // A bookmark exactly as useSavedPlaces.ts writes it (`toFirestoreFields`
    // plus a server timestamp), and nothing else. This rule used to be
    // `isOwner` alone, so the browser could store any fields of any size under
    // any id — the product's cheapest route to unbounded storage cost.
    function isValidSavedPlace(placeId) {
      let d = request.resource.data;
      return placeId.size() <= 128
        && d.keys().hasAll(['type', 'name', 'coordinates', 'savedAt'])
        && d.keys().hasOnly([
             'type', 'name', 'coordinates', 'savedAt',
             'elevation_m', 'prominence_m', 'difficulty', 'activity_type',
             'distance_km', 'elevation_gain_m', 'mountain_type', 'rating',
             'photos', 'place_id'
           ])
        && d.type in ['route', 'mountain', 'campsite']
        && d.name is string && d.name.size() > 0 && d.name.size() <= 200
        && d.coordinates is list && d.coordinates.size() == 2
        // [lng, lat] — GeoJSON order, as everywhere in this codebase.
        && d.coordinates[0] is number && d.coordinates[1] is number
        && d.coordinates[0] >= -180 && d.coordinates[0] <= 180
        && d.coordinates[1] >= -90 && d.coordinates[1] <= 90
        && d.savedAt == request.time
        && optionalNumber(d, 'elevation_m')
        && optionalNumber(d, 'prominence_m')
        && optionalNumber(d, 'distance_km')
        && optionalNumber(d, 'elevation_gain_m')
        && optionalNumber(d, 'rating')
        && (!('rating' in d) || d.rating == null || (d.rating >= 0 && d.rating <= 5))
        && optionalString(d, 'difficulty', 40)
        && optionalString(d, 'activity_type', 40)
        && optionalString(d, 'mountain_type', 40)
        && optionalString(d, 'place_id', 512)
        && photosOk(d);
    }

    // Users collection
    //
    // Rules do NOT cascade into subcollections: `match /users/{userId}` governs
    // the user document alone. Every subcollection needs its own match block, or
    // it falls through to the default deny — which is what happened to
    // saved_places, silently breaking every bookmark in the product.
    //
    // The user document itself is written only by the server (Admin SDK) —
    // the browser never writes it. Owner writes used to be allowed, which let a
    // user forge the `strava_sync` manifest that /api/strava/sync keeps there
    // and that the admin sync dashboard trusts.
    match /users/{userId} {
      allow read: if isOwner(userId);
      allow write: if false; // Admin SDK only

      // Bookmarked routes, peaks and campsites. Written directly by the browser
      // via useSavedPlaces.ts, so this is the rule that has to allow it.
      match /saved_places/{placeId} {
        allow read, delete: if isOwner(userId);
        allow create, update: if isOwner(userId) && isValidSavedPlace(placeId);
      }

      // Strava historical activities synced server-side via Admin SDK
      // Users can read their own activities; writes are via Admin SDK only (write: false)
      match /strava_activities/{activityId} {
        allow read: if isOwner(userId);
        allow write: if false; // Admin SDK only
      }
    }

    // The next four collections are written only by the backend, through the
    // Admin SDK, which bypasses these rules. No browser code writes them. They
    // used to allow owner create/update of any fields at any size — storage
    // anyone signed in could fill at our expense, for a feature with no client.
    // Reopen a write path with a validator, like saved_places, when one needs it.

    // Activities collection — scoped to the owning user
    match /activities/{activityId} {
      allow read: if ownsExisting();
      allow write: if false; // Admin SDK only
    }

    // Routes collection — readable by all authenticated users, writable only by the backend
    match /routes/{routeId} {
      allow read: if isAuthenticated();
      allow write: if false; // backend service account only
    }

    // Places cache — shared regional cache for Google Maps results.
    //
    // Closed to clients in both directions. Visitors reach it through
    // /api/places/cache, which reads with the Admin SDK and is rate limited.
    // Public read (what this used to be) let anyone page through the whole
    // collection with the client SDK — unmetered, bypassing that limit, and
    // exposing `written_by` uids alongside cached Google content.
    //
    // Entries carry `expiresAt`, deleted by the TTL policy declared in
    // firestore.indexes.json.
    match /places_cache/{gridKey} {
      allow read, write: if false; // Admin SDK only
    }

    // Rate-limit counters — written only by the Admin SDK from route handlers.
    // A client that could read these would learn other callers' usage, and one
    // that could write them could hand itself an unlimited budget.
    //
    // Configure a Firestore TTL policy on the `expiresAt` field of this
    // collection; otherwise one document per caller per window accumulates for
    // ever. See src/frontend/src/lib/rateLimit.ts.
    match /rate_limits/{bucketId} {
      allow read, write: if false; // Admin SDK only
    }

    // Chat transcripts — written by /api/chat via the Admin SDK, never by a
    // browser. The default deny already covers this; it is spelled out because
    // an unlisted collection reads as an oversight rather than a decision, and
    // these documents hold whatever users typed into the assistant.
    //
    // Closed to clients even though documents now carry `user_id`: that field
    // exists so erasure and export can find a transcript server-side, not to
    // open a read path. Users reach their own transcripts through
    // /api/account/export, which verifies the token and scopes the query.
    //
    // Needs a Firestore TTL policy on `expiresAt`, at collection-group scope so
    // it covers `messages` too. Without it the 90-day retention that /api/chat
    // stamps is a field nothing acts on.
    match /chat_sessions/{sessionId} {
      allow read, write: if false; // Admin SDK only
      match /messages/{messageId} {
        allow read, write: if false; // Admin SDK only
      }
    }

    // Strava OAuth tokens — written and read only by the Admin SDK.
    //
    // Closed to clients, and that is the entire point of the collection. These
    // used to live in the browser's localStorage, where any XSS on the origin
    // could read them — and a Strava *refresh* token does not expire, so that was
    // permanent access to someone's training history.
    //
    // They are deliberately NOT on `users/{uid}`: that document grants
    // `isOwner(userId)` read access, so anything stored there is readable by that
    // user's browser, which would put the credential straight back where it was.
    match /strava_tokens/{userId} {
      allow read, write: if false; // Admin SDK only
    }

    // Audit trail — privileged actions, erasures, and denied admin attempts.
    //
    // Closed in both directions, which is the point. No client reads it: the
    // records name which admin touched what, and that is a map of who to phish.
    // No client writes it: an audit log a caller can append to is one an
    // attacker can pad with noise to bury the entry that matters.
    //
    // There is deliberately no update or delete path anywhere in the codebase —
    // src/frontend/src/lib/auditLog.ts only ever adds — so the trail is
    // append-only in practice and not merely by convention. Ageing out is left
    // to a Firestore TTL policy on `expiresAt` (730 days), which is the one
    // removal mechanism, and it is configured in the console rather than
    // reachable from application code.
    match /audit_logs/{entryId} {
      allow read, write: if false; // Admin SDK only
    }

    // Training programs — scoped to the owning user
    match /training_programs/{programId} {
      allow read: if ownsExisting();
      allow write: if false; // Admin SDK only
    }

    // Training sessions — scoped to the owning user
    // Every session carries its own user_id rather than inheriting ownership
    // from a parent program: resolving the parent would need a get() per rule
    // evaluation, and an authenticated-only rule (what this was) let any signed-in
    // user read or write anyone else's sessions.
    match /training_sessions/{sessionId} {
      allow read: if ownsExisting();
      allow write: if false; // Admin SDK only
    }

    // Itineraries — scoped to the owning user
    match /itineraries/{itineraryId} {
      allow read: if ownsExisting();
      allow write: if false; // Admin SDK only
    }
  }
}
