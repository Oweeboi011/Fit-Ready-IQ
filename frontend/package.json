{
  "name": "fit-ready-iq-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4790",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:dup": "jscpd",
    "graph:deps": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid",
    "quality": "npm run lint && npm run type-check && npm run lint:deps && npm run lint:dup",
    "type-check": "tsc --noEmit",
    "format": "prettier --write \"**/*.{js,jsx,ts,tsx,json,md}\"",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "scrape:advisories": "tsx scripts/scrape-advisories.ts",
    "test:e2e": "playwright test",
    "test:load": "node tests/performance/load-test.js",
    "test:mutation": "stryker run",
    "prepare": "cd .. && husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-google-maps/api": "^2.19.3",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.0.0",
    "lucide-react": "^0.577.0",
    "next": "^16.3.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@playwright/test": "^1.62.1",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^18.2.48",
    "@types/react-dom": "^18.2.18",
    "@vitest/coverage-v8": "^4.1.10",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.16",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.0",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "jsdom": "^25.0.1",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.33",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^3.4.1",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.10"
  }
}
