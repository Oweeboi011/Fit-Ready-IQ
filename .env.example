# Fit-Ready-IQ — the single environment file for the whole repository.
#
# Copy to `.env.local` in this directory. There is deliberately one file rather
# than one per runtime, and both read it:
#
#   * The Next app, via `process.loadEnvFile()` at the top of
#     src/frontend/next.config.js. Next only auto-loads env files sitting in its
#     own directory, so a root file has to be loaded explicitly — and it has to
#     happen in the config, because that runs before compilation, which is when
#     NEXT_PUBLIC_* values are inlined into the browser bundle.
#   * The FastAPI backend, via `env_file` in src/backend/src/config/settings.py.
#     It runs with extra="ignore" so the frontend's variables do not trip it.
#
# Every variable here is read by something, and everything read is here.
# `envCoverage.test.ts` fails the build if that stops being true in either
# direction, or if a secret-looking name gains a NEXT_PUBLIC_ prefix.
#
# NEXT_PUBLIC_ is compiled into the browser bundle. Never put a secret behind it.

# ── Map, discovery and routing ────────────────────────────────────────────────
# No keys. The map is MapLibre on OpenFreeMap tiles; routes, peaks and campsites
# come from OpenStreetMap through /api/discover; search is Photon; directions are
# OSRM (#86). The only Google key left is the optional weather one below.
#
# Routing (optional). Blank uses FOSSGIS's public OSRM servers
# (https://routing.openstreetmap.de), which serve /routed-{foot,bike,car}/. Point
# it at a self-hosted OSRM laid out the same way once that is not enough.
ROUTING_API_URL=

# ── App metadata ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Fit-Ready-IQ
NEXT_PUBLIC_APP_URL=http://localhost:4790

# ── AI assistant (/api/chat) ──────────────────────────────────────────────────
# Without it the chat route answers 503 and says it is not configured.
GEMINI_API_KEY=
# Optional. The model id; defaults to the current stable Flash (see /api/chat).
# Set it when Google retires a model, instead of changing code.
GEMINI_MODEL=

# ── Weather (/api/weather) ────────────────────────────────────────────────────
# Two DIFFERENT providers, not two names for one key: Google Weather is tried
# first, OpenWeather is the fallback. Both optional — with neither, the route
# reports weather as unavailable rather than guessing.
#
# GOOGLE_WEATHER_API_KEY is called server-to-server, which sends no referer, so
# it must be a key with NO HTTP-referrer restriction (restrict by IP instead).
GOOGLE_WEATHER_API_KEY=
OPENWEATHER_API_KEY=
# Override only for a proxy or a non-default API version.
OPENWEATHER_BASE_URL=

# Elevation (optional). Blank uses the public OpenTopoData API (no key, ~1 000
# calls a day shared by everyone, one call a second). Point it at a self-hosted
# OpenTopoData-compatible endpoint, e.g. https://elevation.example.com/v1/mapzen,
# once that quota is not enough.
ELEVATION_API_URL=

# ── Firebase web app (browser: sign-in and saved places) ──────────────────────
# Firebase Console > Project Settings > Your Apps > Web App. These four are
# exactly what src/frontend/src/lib/firebaseClient.ts reads; storageBucket and
# messagingSenderId are absent because nothing uses Storage or FCM.
#
# The web API key is public by design — it ships in the browser bundle and is
# secured by Firestore rules and the authorised-domain list, not by secrecy.
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=your-project-id.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=your-project-id
NEXT_PUBLIC_FIREBASE_APP_ID=

# ── Firebase Admin (server-side) ──────────────────────────────────────────────
# Credentials are tried in this order: SERVICE_ACCOUNT_KEY_JSON (the whole JSON
# on one line), then CLIENT_EMAIL + PRIVATE_KEY, then Application Default
# Credentials.
#
# Locally all three can stay blank: `gcloud auth application-default login` gives
# the SDK ADC and Firestore just works. Vercel has no ADC, so production needs
# the JSON. That key bypasses Firestore security rules entirely — treat it
# accordingly, and never give it a NEXT_PUBLIC_ prefix.
FIREBASE_PROJECT_ID=your-project-id
FIREBASE_SERVICE_ACCOUNT_KEY_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Backend only. A path is easier than JSON for local runs.
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# ── Strava ────────────────────────────────────────────────────────────────────
# The client id is needed in BOTH forms, which is easy to miss: the browser reads
# the NEXT_PUBLIC_ one to build the authorize URL, so without it the Connect
# Strava button cannot start the flow. The id is public by nature (it travels in
# that URL); the secret must never gain a NEXT_PUBLIC_ prefix.
#
# Set the app's Authorization Callback Domain to `localhost` — domain only, no
# port or scheme, or Strava rejects the redirect.
NEXT_PUBLIC_STRAVA_CLIENT_ID=
STRAVA_CLIENT_ID=
STRAVA_CLIENT_SECRET=

# ── Admin console ─────────────────────────────────────────────────────────────
# Comma-separated emails allowed to open /admin/settings and call /api/admin/*.
# Server-side only — never NEXT_PUBLIC_, or you ship the list of accounts worth
# phishing. Empty or missing denies everyone, including you.
#
# This is the bootstrap and always outranks the `fri_role` custom claim, so a
# misconfigured claim cannot lock out the last administrator.
ADMIN_EMAILS=you@example.com

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Secret key for the HMAC that hashes rate-limit bucket ids (a uid or client IP).
# Optional, but set it in production: without it the ids are a plain SHA-256,
# and a hashed IPv4 address is reversible by trying all four billion of them.
# Any long random string, e.g. `openssl rand -hex 32`. Rotating it only resets
# the current hour's counters.
RATE_LIMIT_SALT=

# ── Expiry sweep ──────────────────────────────────────────────────────────────
# Shared secret for /api/cron/expire, the daily job that deletes expired chat
# transcripts, audit entries, cache cells and rate-limit counters. Firestore TTL
# needs the paid Blaze plan; this keeps the project free. Vercel sends it as
# `Authorization: Bearer <value>` on every cron run. Without it the route refuses
# every caller and nothing expires. Any long random string, e.g.
# `openssl rand -hex 32`.
CRON_SECRET=

# ── Advisories ────────────────────────────────────────────────────────────────
# Closures, hazards, rescues. Optional: point at a JSON feed, or run
# `npm run scrape:advisories`. With neither, the API says no source is connected
# — it never claims trails are clear.
ADVISORY_FEED_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
# Shared by both runtimes, which normalise case themselves. DEBUG, INFO and
# ERROR mean the same thing to each; the middle level differs (the Next logger
# calls it `warn`, Python calls it `WARNING`), so prefer one of the three.
LOG_LEVEL=INFO

# ── Content-Security-Policy ───────────────────────────────────────────────────
# Unset, the full resource policy is sent Report-Only and enforces nothing. Set
# to "true" to enforce it — roll out on a preview deployment first, see
# docs/guides/runbooks/csp-enforcement.md. Unsetting rolls back instantly, no deploy.
CSP_ENFORCE_RESOURCES=
# Where the browser posts violation reports. Without it they appear only in each
# visitor's own console, where nobody sees them.
CSP_REPORT_URI=

# ── Backend only (FastAPI, src/backend — not yet deployed) ────────────────────
APP_NAME=Fit-Ready-IQ
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# JSON array, NOT comma-separated: `cors_origins` is a list[str] and
# pydantic-settings JSON-decodes complex types before any validator runs, so the
# comma form takes the app down at startup. A "*" wildcard is refused outright —
# it cannot combine with credentialed requests.
CORS_ORIGINS=["http://localhost:4790","http://127.0.0.1:4790"]

RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000
# slowapi's counter store. The default is per-process, so each worker enforces
# its own share and the real limit is the number above times the worker count.
# Point at Redis (e.g. redis://localhost:6379) for any multi-worker deployment.
RATE_LIMIT_STORAGE_URI=memory://

# Optional. When set, Sentry initialises with send_default_pii=False.
SENTRY_DSN=

# ── Firebase emulators (docker-compose up -d) ────────────────────────────────
# Ports match firebase.json — change both or neither.
FIREBASE_USE_EMULATOR=false
FIREBASE_EMULATOR_HOST=localhost
FIREBASE_FIRESTORE_EMULATOR_PORT=8080
FIREBASE_AUTH_EMULATOR_PORT=9099
