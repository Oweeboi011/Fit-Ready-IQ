{
  "name": "fit-ready-iq-frontend",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 4790",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "lint:deps": "depcruise src --config .dependency-cruiser.cjs",
    "lint:dup": "jscpd",
    "lint:dead": "knip",
    "lint:docs": "tsx scripts/check-docs.ts",
    "graph:deps": "depcruise src --config .dependency-cruiser.cjs --output-type mermaid",
    "quality": "npm run lint && npm run format:check && npm run type-check && npm run lint:deps && npm run lint:dup && npm run lint:dead && npm run lint:docs",
    "type-check": "tsc --noEmit",
    "env:check": "tsx scripts/check-env.ts",
    "format": "prettier --write . ../../docs \"../../*.md\" --config .prettierrc",
    "format:check": "prettier --check . ../../docs \"../../*.md\" --config .prettierrc",
    "test": "vitest run --coverage",
    "test:unit": "vitest run --coverage",
    "test:rules": "npx --yes firebase-tools@15.31.0 emulators:exec --only firestore --project demo-fit-ready-iq --config ../../firebase.json \"vitest run -c vitest.rules.config.ts\"",
    "scrape:advisories": "tsx scripts/scrape-advisories.ts",
    "test:e2e": "playwright test",
    "test:load": "node tests/performance/load-test.js",
    "test:mutation": "stryker run",
    "prepare": "cd ../.. && husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{js,jsx,json,md}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@react-google-maps/api": "^2.19.3",
    "firebase": "^12.15.0",
    "firebase-admin": "^14.5.0",
    "lucide-react": "^0.577.0",
    "next": "^16.3.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@firebase/rules-unit-testing": "^5.0.2",
    "@playwright/test": "^1.62.1",
    "@secretlint/secretlint-rule-preset-recommend": "^13.0.7",
    "@stryker-mutator/core": "^9.6.1",
    "@stryker-mutator/vitest-runner": "^9.6.1",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitest/coverage-v8": "^4.1.11",
    "autocannon": "^8.0.0",
    "autoprefixer": "^10.4.16",
    "dependency-cruiser": "^18.1.1",
    "eslint": "^9.39.5",
    "eslint-config-next": "^16.3.6",
    "husky": "^9.1.7",
    "jscpd": "^5.0.14",
    "jsdom": "^25.0.1",
    "knip": "^6.39.0",
    "lint-staged": "^17.3.0",
    "postcss": "^8.4.33",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "secretlint": "^13.0.7",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.23.12",
    "typescript": "^5.3.3",
    "typescript-eslint": "^8.66.0",
    "vitest": "^4.1.11"
  },
  "overrides": {
    "gaxios": "^7.3.1",
    "teeny-request": "^11.0.1",
    "retry-request": "^9.0.1",
    "qs": "^6.15.3",
    "typed-rest-client": "^3.1.0",
    "uuid": "^11.1.1",
    "@grpc/grpc-js": "^1.14.7",
    "brace-expansion@^5.0.0": "^5.0.12"
  }
}
