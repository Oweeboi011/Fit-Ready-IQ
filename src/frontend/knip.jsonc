{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts", "tests/**/*.{ts,js}"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,js}"],
  "ignoreExportsUsedInFile": true,
  // Run from the Husky hooks at the repo root, which knip cannot see.
  "ignoreDependencies": [
    "@commitlint/cli",
    "lint-staged",
    "secretlint",
    "@secretlint/secretlint-rule-preset-recommend"
  ]
}
