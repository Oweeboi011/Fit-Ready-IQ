{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "entry": ["scripts/*.ts", "tests/**/*.{ts,js}"],
  "project": ["src/**/*.{ts,tsx}", "scripts/**/*.ts", "tests/**/*.{ts,js}"],
  // Values exported but used only in their own file are dead surface; types
  // are exempt because they usually name a public signature.
  "ignoreExportsUsedInFile": { "interface": true, "type": true },
  // Run from the Husky hooks at the repo root, which knip cannot see.
  "ignoreDependencies": [
    "@commitlint/cli",
    "lint-staged",
    "secretlint",
    "@secretlint/secretlint-rule-preset-recommend",
  ],
}
