{
  "path": ["src", "../backend/src"],
  "format": ["typescript", "tsx", "python"],
  "ignore": [
    "**/node_modules/**",
    "**/.next/**",
    "**/.stryker-tmp/**",
    "**/coverage/**",
    "**/reports/**",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/.venv/**",
    "**/__pycache__/**"
  ],
  "minLines": 12,
  "minTokens": 100,
  "threshold": 3,
  "reporters": ["console", "json"],
  "output": "reports/jscpd",
  "absolute": false,
  "gitignore": true
}
