# Frontend environment variables — copy to .env.local and fill in your values.
# See docs/wiki/DEPLOYMENT.md for full documentation.
#
# Every variable here is read by code in src/. Anything that stopped being read
# has been removed, so this file is an inventory rather than a wishlist.

# ── Google Maps (required) ────────────────────────────────────────────────────
# Restrict the key to your domains in Google Cloud Console, and enable:
#   Maps JavaScript API   — the map itself
#   Places API (legacy)   — route / peak / campsite discovery
#   Elevation API         — relief and difficulty banding
#   Routes API            — directions and planner path snapping
# Billing must be enabled on the project, or Maps answers with
# ApiProjectMapError even when the key is valid.
#
# Without this the map surface renders its own error state with a retry — it
# does not silently show a broken map.
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Optional separate server-side key for the Routes API. Falls back to
# NEXT_PUBLIC_GOOGLE_MAPS_API_KEY. Must be the Routes API, not the legacy
# Directions API, which Google no longer enables on new projects.
GOOGLE_ROUTES_API_KEY=

# ── App metadata ──────────────────────────────────────────────────────────────
NEXT_PUBLIC_API_URL=http://localhost:8000
NEXT_PUBLIC_APP_NAME=Fit-Ready-IQ
NEXT_PUBLIC_APP_URL=http://localhost:4790

# ── AI assistant (server-side, /api/chat) ─────────────────────────────────────
# Without it the chat route answers 503 and says it is not configured.
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# ── Weather (server-side, /api/weather) ───────────────────────────────────────
# Two DIFFERENT providers, not aliases for one key — an earlier version of this
# file said otherwise, which would put an OpenWeather key where a Google one is
# expected and fail every primary call.
#
# Google Weather is tried first, OpenWeather is the fallback. Both are optional:
# with neither, the route reports weather as unavailable rather than guessing.
GOOGLE_WEATHER_API_KEY=
OPENWEATHER_API_KEY=

# Override only if you are pointing at a proxy or a non-default API version.
OPENWEATHER_BASE_URL=

# ── Firebase web app (client-side sign-in + saved places) ─────────────────────
# Firebase Console > Project Settings > Your Apps > Web App.
# These four are exactly what src/lib/firebaseClient.ts reads. `storageBucket`
# and `messagingSenderId` were listed here but never passed to initializeApp —
# nothing in the app uses Firebase Storage or FCM — so they have been removed.
# Re-add them alongside the code that needs them (storage.rules is already
# written for the day Storage is wired up).
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# ── Firebase Admin (server-side API routes) ───────────────────────────────────
# Credentials are tried in this order: SERVICE_ACCOUNT_KEY_JSON (full JSON),
# then CLIENT_EMAIL + PRIVATE_KEY, then Application Default Credentials.
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_KEY_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# ── Strava ────────────────────────────────────────────────────────────────────
# The client id is needed in BOTH forms, and this is easy to get wrong:
#
#   NEXT_PUBLIC_STRAVA_CLIENT_ID — read in the browser by ConnectDevicesModal to
#     build the OAuth authorize URL. Without it the "Connect Strava" button
#     cannot start the flow at all. It was missing from this file entirely.
#   STRAVA_CLIENT_ID / _SECRET   — server-side only, for the token exchange in
#     /api/strava/exchange and /api/strava/refresh.
#
# The id is public by nature (it travels in the authorize URL). The secret is
# not, and must never gain a NEXT_PUBLIC_ prefix.
NEXT_PUBLIC_STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET

# ── Admin console ─────────────────────────────────────────────────────────────
# Comma-separated emails allowed to open /admin/settings and call /api/admin/*.
# Server-side only — never NEXT_PUBLIC_, or you ship the list of accounts worth
# phishing to every visitor. Empty or missing denies everyone, including you.
#
# This is the bootstrap and always outranks the `fri_role` custom claim, so a
# misconfigured claim cannot lock out the last administrator.
ADMIN_EMAILS=you@example.com

# ── Advisories ────────────────────────────────────────────────────────────────
# Mountain closures, hazards, rescues. Optional. Either point this at a JSON
# feed, or run `npm run scrape:advisories` to generate data/advisories.json.
# With neither, the API reports no source connected — it never claims trails
# are clear.
ADVISORY_FEED_URL=

# ── Logging ───────────────────────────────────────────────────────────────────
# Minimum level emitted by the structured server-side logger (src/lib/logger.ts).
# One of: debug, info, warn, error. Defaults to info.
LOG_LEVEL=

# ── Content-Security-Policy ───────────────────────────────────────────────────
# Unset, the full resource policy is sent Report-Only and enforces nothing.
# Set to "true" to enforce it. Roll out on a preview deployment first — see
# docs/runbooks/csp-enforcement.md. Unsetting it rolls back instantly, no deploy.
CSP_ENFORCE_RESOURCES=

# Where the browser posts CSP violation reports. Optional, but without it
# violations only appear in each visitor's own console, where nobody sees them.
CSP_REPORT_URI=
