# Frontend environment variables — copy this file to .env.local and fill in your values
# See docs/wiki/DEPLOYMENT.md for full documentation

# Google Maps (required) — restrict to your domain in Google Cloud Console
# Enable: Maps JavaScript API, Places API, Geocoding API, Elevation API, Distance Matrix API
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Backend API URL
NEXT_PUBLIC_API_URL=http://localhost:8000

# App metadata
NEXT_PUBLIC_APP_NAME=Fit-Ready-IQ
NEXT_PUBLIC_APP_URL=http://localhost:4790

# Gemini (server-side route /api/chat)
GEMINI_API_KEY=YOUR_GEMINI_API_KEY

# Weather API (server-side route /api/weather) — use OpenWeather API key
# Get one at https://openweathermap.org/api
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
# Alias also accepted:
# GOOGLE_WEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY

# Firebase web app config (client-side Google sign-in + Firestore saved places)
# Found in: Firebase Console > Project Settings > Your Apps > Web App
NEXT_PUBLIC_FIREBASE_API_KEY=YOUR_FIREBASE_WEB_API_KEY
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=YOUR_FIREBASE_PROJECT_ID.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=YOUR_FIREBASE_PROJECT_ID.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=YOUR_MESSAGING_SENDER_ID
NEXT_PUBLIC_FIREBASE_APP_ID=YOUR_FIREBASE_APP_ID

# Firebase admin config (server-side API routes)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_KEY_JSON=
FIREBASE_CLIENT_EMAIL=
FIREBASE_PRIVATE_KEY=

# Strava OAuth
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET

# Admin console allowlist (server-side only — never NEXT_PUBLIC_).
# Comma-separated emails allowed to open /admin/settings and call /api/admin/*.
# An empty or missing value denies everyone, including you.
ADMIN_EMAILS=you@example.com

# Routing (Routes API). Optional — falls back to NEXT_PUBLIC_GOOGLE_MAPS_API_KEY.
# Note: this must be the Routes API, not the legacy Directions API, which
# Google no longer enables on new projects.
GOOGLE_ROUTES_API_KEY=

# Mountain advisories: closures, hazards, rescues. Optional.
# Either point this at a JSON feed, or run `npm run scrape:advisories` to
# generate data/advisories.json from scripts/advisory-sources.json.
ADVISORY_FEED_URL=

# Content-Security-Policy enforcement.
# Unset, the full resource policy is sent Report-Only and enforces nothing.
# Set to "true" to enforce it. Roll it out on a preview deployment first —
# see docs/runbooks/csp-enforcement.md. Unsetting it rolls back instantly,
# with no deploy.
CSP_ENFORCE_RESOURCES=

# Where the browser posts CSP violation reports. Optional, but without it
# violations only appear in each visitor's own console, where nobody sees them.
CSP_REPORT_URI=
