# Fit-Ready-IQ backend configuration.
#
# Every variable here maps to a field on `Settings` in src/config/settings.py,
# and every field there is read by something. That correspondence is load-bearing
# in both directions:
#
#   * pydantic-settings runs with `extra="forbid"`, so a variable in .env that
#     is NOT a settings field makes the app refuse to start. A stale name left
#     behind after a refactor is a hard failure, not dead weight — which is why
#     `GOOGLE_MAPS_API_KEY` was removed from this file: it was documented here
#     but never a field, so copying this file verbatim used to break startup.
#   * Twelve fields were removed because nothing read them, five of which were
#     *required* and killed the app on a ValidationError unless you supplied
#     values it then ignored. Strava and weather credentials live with the Next
#     routes in src/frontend/src/app/api/, which are what actually call those
#     APIs; duplicating them here only created a second source of truth.
#
# Copy to .env. Only FIREBASE_PROJECT_ID has no default.

# ── Application ───────────────────────────────────────────────────────────────
APP_NAME=Fit-Ready-IQ
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=8000

# Filters application logs. Genuinely applied now — structlog previously did no
# level filtering at all, so this only ever reached uvicorn's own logger.
# One of: DEBUG, INFO, WARNING, ERROR.
LOG_LEVEL=INFO

# ── Firebase ──────────────────────────────────────────────────────────────────
# The only setting with no default. Without it the app cannot start, and that is
# correct: there is nothing useful to serve without a project.
FIREBASE_PROJECT_ID=your-firebase-project-id

# Admin credentials, in the order the SDK tries them. Supply the JSON string in
# production; the path is easier locally. Leave both blank to use Application
# Default Credentials.
FIREBASE_SERVICE_ACCOUNT_KEY_JSON=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=

# e.g. "your-project-id.appspot.com"
FIREBASE_STORAGE_BUCKET=

# ── Firebase emulators (local development) ────────────────────────────────────
# `docker-compose up -d` from the repo root starts these. Ports match
# firebase.json — change both or neither.
FIREBASE_USE_EMULATOR=false
FIREBASE_EMULATOR_HOST=localhost
FIREBASE_FIRESTORE_EMULATOR_PORT=8080
FIREBASE_AUTH_EMULATOR_PORT=9099
FIREBASE_STORAGE_EMULATOR_PORT=9199

# ── Rate limiting ─────────────────────────────────────────────────────────────
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Where slowapi keeps its counters. The default is per-process, so each worker
# enforces its own share and the effective limit is the number above times the
# worker count. Point this at Redis (e.g. "redis://localhost:6379") for any
# deployment running more than one worker, or the limit is not what you set.
RATE_LIMIT_STORAGE_URI=memory://

# ── CORS ──────────────────────────────────────────────────────────────────────
# Must be a JSON array, not comma-separated. `cors_origins` is a `list[str]`,
# and pydantic-settings JSON-decodes complex types straight from the dotenv file
# before any validator runs — the comma form takes the app down at startup.
#
# A "*" wildcard is refused at startup: it cannot combine with credentialed
# requests, so it would not produce a permissive API, just one where every
# cross-origin call silently fails.
CORS_ORIGINS=["http://localhost:4790","http://127.0.0.1:4790"]

# ── Error tracking ────────────────────────────────────────────────────────────
# Optional. When set, Sentry is initialised with send_default_pii=False.
SENTRY_DSN=
