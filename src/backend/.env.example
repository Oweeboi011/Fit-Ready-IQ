# Backend environment variables — copy this file to .env and fill in your values
# See docs/wiki/DEPLOYMENT.md for full documentation

# Application
APP_NAME=Fit-Ready-IQ
ENVIRONMENT=development
API_HOST=0.0.0.0
API_PORT=6790
LOG_LEVEL=INFO

# Firebase (required)
FIREBASE_PROJECT_ID=YOUR_FIREBASE_PROJECT_ID
FIREBASE_SERVICE_ACCOUNT_KEY_JSON=
FIREBASE_SERVICE_ACCOUNT_KEY_PATH=
FIREBASE_STORAGE_BUCKET=

# Firebase emulator (local dev only)
FIREBASE_USE_EMULATOR=false
FIREBASE_EMULATOR_HOST=localhost

# Strava OAuth (required)
STRAVA_CLIENT_ID=YOUR_STRAVA_CLIENT_ID
STRAVA_CLIENT_SECRET=YOUR_STRAVA_CLIENT_SECRET
STRAVA_REDIRECT_URI=http://localhost:6790/auth/strava/callback
STRAVA_WEBHOOK_VERIFY_TOKEN=

# External APIs (required)
MAPBOX_ACCESS_TOKEN=YOUR_MAPBOX_TOKEN
OPENWEATHER_API_KEY=YOUR_OPENWEATHER_API_KEY
OPENWEATHER_BASE_URL=https://api.openweathermap.org/data/2.5

# Google Maps backend (for elevation/directions server-side calls)
GOOGLE_MAPS_API_KEY=YOUR_GOOGLE_MAPS_API_KEY

# Optional route data sources
OSM_OVERPASS_URL=https://overpass-api.de/api/interpreter
HIKING_PROJECT_API_KEY=

# Rate limiting
RATE_LIMIT_PER_MINUTE=60
RATE_LIMIT_PER_HOUR=1000

# Cache TTLs (seconds)
CACHE_ACTIVITIES_TTL=900
CACHE_ROUTES_TTL=86400
CACHE_WEATHER_TTL=3600

# Error tracking (optional)
SENTRY_DSN=
