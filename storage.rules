rules_version = '2';

// Deny-all. Nothing in the product uses Firebase Storage: no firebase/storage
// import, no bucket provisioned, and firebase.json deliberately declares no
// storage target (deploying one against an unprovisioned bucket fails).
//
// This file used to grant every signed-in user unrestricted read and write on
// `users/{uid}/**`, with no size or content-type limit — dormant only because
// nobody had created a bucket. The day someone did, that would have been free
// file hosting for any Google account. Whoever wires Storage up writes the
// rules for what they actually store, starting from closed.
service firebase.storage {
  match /b/{bucket}/o {
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
